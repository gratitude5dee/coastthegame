# ── Vendor secrets (server-side only: Cloudflare `wrangler secret put` + Codex environment) ──
OPENAI_API_KEY=                 # Realtime (gpt-realtime-2.1[-mini]) + Responses (gpt-6-astra)
WORLDLABS_API_KEY=              # Marble World API (header WLT-Api-Key)
TRIPO_API_KEY=                  # Tripo v3 (image/text→3D, rig, retarget)
FAL_KEY=                        # fal queue: minimax/h3*, wan-22-vace-fun-a14b, tripo3d/*, meshy/*
DECART_API_KEY=                 # Lucy 2.5 realtime (optional in dev; Dream mode)
ELEVENLABS_API_KEY=             # TTS (NPC lines) + SFX (optional; OpenAI TTS fallback)
GOOGLE_MAPS_API_KEY=            # Photorealistic 3D Tiles (Explore mode only; attribution required)
HELIUS_RPC_URL=                 # Solana RPC (devnet first)
CLOUDFLARE_API_TOKEN=           # wrangler deploy (CI)
CLOUDFLARE_ACCOUNT_ID=

# ── OAuth (Worker) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_KEY=
CHATGPT_OAUTH_CLIENT_ID=        # only if "Sign in with ChatGPT" partner access is granted (D-5)
CHATGPT_OAUTH_CLIENT_SECRET=

# ── Client-visible (VITE_*) — never secrets ──
VITE_API_BASE=http://localhost:8787
VITE_ASSETS_BASE=https://assets.coast.wzrd.tech   # R2 public bucket / custom domain
VITE_PHANTOM_APP_ID=
VITE_SOLANA_CLUSTER=devnet
VITE_FEATURE_DREAM=0            # Lucy live restyle
VITE_FEATURE_PORTALS=0          # Spark portals (experimental)
VITE_FEATURE_TILES=0            # Google 3D Tiles explore mode

# ── Dev-time budgets ──
DAILY_SPEND_CAP_USD=40
SESSION_SPEND_CAP_USD=3
