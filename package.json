{
  "name": "coast-the-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @coast/web dev",
    "build": "pnpm -r --filter './packages/**' --filter @coast/web build",
    "preview": "pnpm --filter @coast/web preview",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint . && prettier --check \"**/*.{ts,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "test": "vitest run",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "deploy": "pnpm build && pnpm --filter @coast/api deploy",
    "assets": "tsx tools/assets/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  }
}
